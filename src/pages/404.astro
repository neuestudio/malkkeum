---
import Base from '../layouts/Base.astro';
import { DEFAULT_LANG, path, t } from '../lib/i18n';
const lang = DEFAULT_LANG;
const s = t(lang);
---

<Base lang={lang} title={s.notFound.title} noindex>
  <section class="wrap page-top split" style="min-height:40vh">
    <p class="label">404</p>
    <div>
      <h1 class="lead">{s.notFound.title} <span class="dim">{s.notFound.body}</span></h1>
      <p style="margin-top:32px"><a class="btn" href={path(lang)}>{s.notFound.cta}</a></p>
    </div>
  </section>
</Base>
