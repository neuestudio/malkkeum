---
import Base from '../../layouts/Base.astro';
import { langPaths } from '../../lib/content';
import { path, t, type Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const ko = lang === 'ko';
const f = ko
  ? {
      desc: '청소법 제안, 잘못된 내용 제보, 제휴·광고 문의를 보내주세요. 보통 3영업일 안에 답장드려요.',
      name: '이름',
      email: '이메일',
      topic: '문의 유형',
      topics: ['청소법 제안', '잘못된 내용 제보', '제휴·광고', '기타'],
      message: '내용',
      consent: '문의 답변을 위해 이름, 이메일, 문의 내용을 수집하며 답변 완료 후 1년간 보관 후 삭제하는 데 동의합니다.',
      policy: '개인정보처리방침',
      send: '보내기',
      sending: '보내는 중…',
      ok: '보내주셔서 감사해요. 확인 후 이메일로 답장드릴게요.',
      fail: '전송에 실패했어요. 잠시 후 다시 시도해 주세요.',
    }
  : {
      desc: 'Suggest a guide, report a mistake, or ask about partnerships. We usually reply within three business days.',
      name: 'Name',
      email: 'Email',
      topic: 'Topic',
      topics: ['Suggest a guide', 'Report a mistake', 'Partnership / ads', 'Other'],
      message: 'Message',
      consent: 'I agree that my name, email and message are collected to reply to this inquiry and kept for one year afterwards.',
      policy: 'Privacy policy',
      send: 'Send',
      sending: 'Sending…',
      ok: 'Thank you. We will reply by email.',
      fail: 'Something went wrong. Please try again later.',
    };
---

<Base lang={lang} title={s.footer.contact} description={f.desc}>
  <section class="wrap page-top split">
    <h1 class="label">{s.footer.contact}</h1>
    <p class="lead">{f.desc}</p>
  </section>
  <section class="wrap section split">
    <div></div>
    <form class="form" id="contact" method="post" action="/api/contact" data-sending={f.sending} data-ok={f.ok} data-fail={f.fail}>
      <input type="hidden" name="lang" value={lang} />
      <!-- 스팸 봇용 함정 칸. 사람에게는 보이지 않는다 -->
      <div class="hp" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="row2">
        <label class="field">
          <span>{f.name}</span>
          <input name="name" required maxlength="50" autocomplete="name" />
        </label>
        <label class="field">
          <span>{f.email}</span>
          <input name="email" type="email" required maxlength="120" autocomplete="email" />
        </label>
      </div>
      <label class="field">
        <span>{f.topic}</span>
        <select name="topic">{f.topics.map((o) => <option>{o}</option>)}</select>
      </label>
      <label class="field">
        <span>{f.message}</span>
        <textarea name="message" required minlength="10" maxlength="3000" rows="8"></textarea>
      </label>
      <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>{f.consent} <a href={path(lang, 'privacy')}>{f.policy}</a></span>
      </label>
      <button class="btn" type="submit">{f.send}</button>
      <p class="form__status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>

<style>
  .form {
    display: grid;
    gap: 24px;
    max-width: 720px;
  }
  .row2 {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .row2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field span {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    font-size: 16px;
    color: var(--text);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--text);
    border-radius: 0;
    padding: 10px 0;
    width: 100%;
  }
  .field textarea {
    border: 1px solid var(--text);
    padding: 12px;
    resize: vertical;
  }
  .field :focus {
    outline: none;
    border-color: var(--accent-deep);
    box-shadow: 0 1px 0 var(--accent-deep);
  }
  .consent {
    display: flex;
    gap: 10px;
    font-size: 14px;
    line-height: 1.6;
  }
  .consent input {
    margin-top: 4px;
    accent-color: var(--accent-deep);
  }
  .consent a {
    text-decoration: underline;
  }
  .form .btn {
    justify-self: start;
  }
  .form__status {
    font-size: 15px;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
</style>

<script>
  const form = document.getElementById('contact') as HTMLFormElement;
  const status = form.querySelector<HTMLElement>('.form__status')!;
  const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    status.textContent = form.dataset.sending!;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = form.dataset.ok!;
    } catch {
      status.textContent = form.dataset.fail!;
    } finally {
      btn.disabled = false;
    }
  });
</script>
