---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Media from '../../../components/Media.astro';
import Crumbs from '../../../components/Crumbs.astro';
import GuideCard from '../../../components/GuideCard.astro';
import MagazineCard from '../../../components/MagazineCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SheetBar from '../../../components/SheetBar.astro';
import { detailPaths, entries, pickBySlugs, slugOf, translationsOf } from '../../../lib/content';
import { formatDate, path, t, type Lang } from '../../../lib/i18n';
import { imageOf } from '../../../lib/images';

export const getStaticPaths = () => detailPaths('magazine');

const { entry } = Astro.props as { entry: import('astro:content').CollectionEntry<'magazine'> };
const lang = Astro.params.lang as Lang;
const slug = slugOf(entry.id);
const s = t(lang);
const d = entry.data;
const { Content } = await render(entry);
const hero = imageOf('magazine', slug, d.heroImage);
const related = pickBySlugs(await entries('guides', lang), d.related, entry.id).slice(0, 3);
const more = (await entries('magazine', lang)).filter((m) => m.id !== entry.id).slice(0, 3);
const alternates = Object.fromEntries((await translationsOf('magazine', slug)).map((l) => [l, path(l, `magazine/${slug}`)]));
const url = new URL(path(lang, `magazine/${slug}`), Astro.site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    inLanguage: lang,
    mainEntityOfPage: url,
    datePublished: d.publishedAt.toISOString(),
    dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
    author: { '@type': 'Organization', name: s.siteName },
    publisher: { '@type': 'Organization', name: s.siteName },
    ...(hero.src ? { image: new URL(hero.src, Astro.site).toString() } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: s.home, item: new URL(path(lang), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: s.nav.magazine, item: new URL(path(lang, 'magazine'), Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Base lang={lang} title={d.title} description={d.description} image={hero.src} type="article" alternates={alternates} jsonLd={jsonLd}>
  <article class="wrap page-top" data-pagefind-body>
    <Crumbs items={[{ name: s.nav.magazine, href: path(lang, 'magazine') }, { name: s.kind[d.kind] }]} />
    <header class="a-head">
      <p class="meta">{s.kind[d.kind]} · {formatDate(d.publishedAt, lang)}</p>
      <h1 class="title-xl">{d.title}</h1>
      <p class="a-sum dim">{d.summary}</p>
    </header>
    <figure class="a-hero">
      <Media {...hero} sizes="100vw" alt={d.heroAlt ?? d.title} label={s.kind[d.kind]} tone="sage" eager width={2000} height={1333} />
    </figure>
    <div class="a-body">
      <div class="prose"><Content /></div>
      {d.sheet && <SheetBar lang={lang} slug={slug} title={d.sheet.title} />}
      {d.updatedAt && <p class="meta" style="margin-top:32px">{s.updated} {formatDate(d.updatedAt, lang)}</p>}
    </div>
  </article>

  <div class="wrap"><AdSlot lang={lang} /></div>

  {
    related.length > 0 && (
      <section class="wrap section">
        <div class="section-head"><h2 class="label">{s.sections.related}</h2></div>
        <div class="grid">{related.map((g) => <GuideCard entry={g} lang={lang} />)}</div>
      </section>
    )
  }
  {
    more.length > 0 && (
      <section class="wrap section">
        <div class="section-head"><h2 class="label">{s.sections.relatedMagazine}</h2></div>
        <div class="grid">{more.map((m) => <MagazineCard entry={m} lang={lang} size="lg" />)}</div>
      </section>
    )
  }
</Base>

<style>
  .a-head {
    max-width: 880px;
    margin: 28px auto 40px;
    text-align: center;
  }
  .a-head .meta {
    margin-bottom: 16px;
  }
  .a-sum {
    margin: 20px auto 0;
    font-size: clamp(17px, 1.6vw, 20px);
    max-width: 36em;
  }
  .a-hero {
    aspect-ratio: 3 / 2;
    max-height: 78vh;
    overflow: hidden;
    width: 100%;
  }
  .a-hero :global(.media) {
    width: 100%;
    height: 100%;
  }
  .a-body {
    max-width: 720px;
    margin: clamp(48px, 6vw, 80px) auto 0;
  }
</style>
