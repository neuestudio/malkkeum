---
// 지역 쓰레기 배출 정보 목록 (지금은 서울 25개 구)
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import { waste, wasteVisible, dayLabel, fmtBasis } from '../../../lib/waste';

export function getStaticPaths() {
  return wasteVisible ? [{ params: { lang: 'ko' } }] : [];
}
const list = waste.districts;
const title = '서울 쓰레기 버리는 날 — 25개 구 배출 요일·시간';
const description = '서울 25개 자치구의 일반쓰레기·음식물·재활용 배출 요일과 시간, 배출 장소, 대형폐기물 신청 방법을 공공데이터로 정리했어요. 우리 구 요일로 캘린더 알림도 받을 수 있어요.';
---

<Base lang="ko" title={title} description={description}>
  <section class="wrap page-top">
    <Crumbs items={[{ name: '쓰레기 버리는 날' }]} />
    <header class="split" style="margin-top:24px">
      <div></div>
      <div>
        <h1 class="title-xl">우리 구 쓰레기 버리는 날</h1>
        <p class="dim" style="margin-top:16px;font-size:18px;max-width:40em">
          서울 25개 구의 배출 요일과 시간을 공공데이터로 정리했어요. 우리 구를 고르고, 요일을 캘린더 알림으로 받아 보세요.
        </p>
      </div>
    </header>
  </section>

  <section class="wrap section split">
    <h2 class="label">서울</h2>
    <ul class="wt-gu">
      {list.map((d) => (
        <li>
          {d.missing ? (
            <span class="wt-gu__item is-off">
              <b>{d.name}</b>
              <span>준비 중</span>
            </span>
          ) : (
            <a class="wt-gu__item" href={`/ko/trash/seoul/${d.slug}/`}>
              <b>{d.name}</b>
              <span>
                {d.zones.length > 1 ? `동네별 ${d.zones.length}개 권역` : `일반쓰레기 ${dayLabel(d.zones[0].days.g, d.zones[0].daysText.g)}`}
              </span>
              {d.stale && <span class="wt-gu__old">{fmtBasis(d.basis).slice(0, 5)} 정보 · 확인 필요</span>}
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section split">
    <div></div>
    <p class="dim" style="font-size:14px;max-width:40em">
      출처: <a href={waste.source.url} target="_blank" rel="noopener">{waste.source.name}</a>. 구청이 등록한 내용을 옮겼으며, {waste.source.fetchedAt}에 확인했어요. 실제와 다르다면 <a href="/ko/contact/">정정 제보</a>로 알려 주세요.
    </p>
  </section>
</Base>

<style>
  .wt-gu { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .wt-gu__item { display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 16px 18px; background: var(--surface); border: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  a.wt-gu__item:hover { border-color: var(--text); }
  .wt-gu__item b { font-size: 17px; color: var(--text); }
  .wt-gu__item.is-off { opacity: 0.55; }
  .wt-gu__old { color: #8e4329; font-size: 12px; }
  .dim a { color: var(--accent-deep); border-bottom: 1px solid var(--accent); }
</style>
