---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { toolLangPaths } from '../../../lib/content';
import { path, t, type Lang } from '../../../lib/i18n';

export const getStaticPaths = toolLangPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);

const types = [
  { key: 'g', name: '일반쓰레기', sub: '종량제 봉투', color: 'var(--text)', time: '2000' },
  { key: 'f', name: '음식물 쓰레기', sub: '음식물 전용 봉투·수거함', color: 'var(--medium)', time: '2000' },
  { key: 'r', name: '재활용', sub: '플라스틱·종이·캔·비닐', color: 'var(--accent-deep)', time: '1900' },
];
const days = [
  ['MO', '월'],
  ['TU', '화'],
  ['WE', '수'],
  ['TH', '목'],
  ['FR', '금'],
  ['SA', '토'],
  ['SU', '일'],
];
const title = '쓰레기 버리는 날 알림 — 종량제·음식물·재활용 요일을 캘린더에';
const description =
  '일반쓰레기(종량제), 음식물 쓰레기, 재활용 분리배출 요일과 시간을 고르면 아이폰·갤럭시·구글 캘린더에 매주 반복 알림으로 넣어 드려요. 헷갈리는 분리배출 기준도 함께 정리했어요.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '말끔 쓰레기 배출일 알림',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'iOS, Android, Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
    url: new URL(path(lang, 'tools/trash-day'), Astro.site).toString(),
    inLanguage: lang,
  },
];
---

<Base lang={lang} title={title} description={description} jsonLd={jsonLd}>
  <section class="wrap page-top">
    <Crumbs items={[{ name: s.nav.tools, href: path(lang, 'tools') }, { name: '쓰레기 배출일 알림' }]} />
    <header class="td-head split">
      <div></div>
      <div>
        <h1 class="title-xl">쓰레기 버리는 날, 이제 캘린더가 알려줘요</h1>
        <p class="td-sum dim">우리 집 배출 요일과 시간을 고르면 휴대폰 캘린더에 매주 반복 알림으로 들어가요. 로그인도 앱 설치도 필요 없어요.</p>
      </div>
    </header>
  </section>

  <section class="wrap split">
    <h2 class="label">요일 고르기</h2>
    <form class="td" id="trash-form" novalidate>
      {
        types.map((ty) => (
          <fieldset class="td-row" data-key={ty.key}>
            <legend class="td-name">
              <span class="td-dot" style={`background:${ty.color}`} />
              {ty.name}
              <span class="td-sub">{ty.sub}</span>
            </legend>
            <div class="td-days" role="group" aria-label={`${ty.name} 배출 요일`}>
              {days.map(([code, label]) => (
                <button type="button" class="td-day" data-day={code} aria-pressed="false">
                  {label}
                </button>
              ))}
            </div>
            <label class="td-time">
              <span>알림 기준 시각</span>
              <input type="time" id={`time-${ty.key}`} value={`${ty.time.slice(0, 2)}:${ty.time.slice(2)}`} step="600" />
            </label>
          </fieldset>
        ))
      }

      <div class="td-opts">
        <label class="td-time">
          <span>언제 알려줄까요</span>
          <select id="alarm">
            <option value="0">그 시각에</option>
            <option value="30" selected>30분 전</option>
            <option value="60">1시간 전</option>
            <option value="1440">하루 전</option>
          </select>
        </label>
        <p class="td-summary" id="summary" aria-live="polite">버리는 요일을 하나 이상 골라 주세요.</p>
      </div>

      <div class="td-actions" id="actions" hidden>
        <a class="btn" id="ics-link" href="#" rel="nofollow">캘린더에 추가 (아이폰·갤럭시)</a>
        <div class="td-google" id="google-links"></div>
      </div>
      <p class="td-note">고른 요일은 이 기기의 브라우저에만 저장돼요. 요일이 바뀌면 다시 골라서 추가하고, 예전 일정은 캘린더에서 지워 주세요.</p>
    </form>
  </section>

  <section class="wrap section split">
    <h2 class="label">캘린더에 넣는 법</h2>
    <div class="prose">
      <ul>
        <li><strong>아이폰</strong> — "캘린더에 추가"를 누르고 "모두 추가"를 고르면 끝나요.</li>
        <li><strong>갤럭시</strong> — 내려받은 파일을 열고 삼성 캘린더를 선택하면 일정이 들어가요.</li>
        <li><strong>구글 캘린더</strong> — 종류별 "구글 캘린더" 버튼을 눌러 저장하세요. 알림 시간은 구글 캘린더 기본 알림을 따라요.</li>
      </ul>
    </div>
  </section>

  <div class="wrap"><AdSlot lang={lang} /></div>

  <article class="wrap section split" data-pagefind-body>
    <div></div>
    <div class="prose">
      <h2>배출 요일과 시간은 어디서 확인할까요</h2>
      <p>쓰레기 배출 요일과 시간은 <strong>사는 지역(구·군)과 주택 형태</strong>에 따라 달라요. 아파트는 관리사무소 게시판이나 단지 안내문에, 단독·빌라는 구청이나 군청 홈페이지의 "생활쓰레기 배출 안내"에 적혀 있어요. 정해진 시간 밖에 내놓으면 수거가 안 되거나 과태료 대상이 될 수 있으니 한 번 확인해 두세요.</p>

      <h2>종량제 봉투에 넣는 것, 넣지 않는 것</h2>
      <p>재활용이 안 되는 생활쓰레기는 종량제 봉투에 담아요. 다만 아래는 따로 버려야 해요.</p>
      <table>
        <thead><tr><th>품목</th><th>버리는 곳</th></tr></thead>
        <tbody>
          <tr><td>깨진 유리, 도자기, 뚝배기</td><td>불연성 쓰레기 전용 마대(특수규격 마대)</td></tr>
          <tr><td>폐건전지, 폐형광등</td><td>주민센터·아파트의 전용 수거함</td></tr>
          <tr><td>먹다 남은 약(폐의약품)</td><td>약국, 보건소, 주민센터의 폐의약품 수거함</td></tr>
          <tr><td>가구, 가전, 매트리스 같은 큰 물건</td><td>대형폐기물로 신고 후 배출</td></tr>
        </tbody>
      </table>

      <h2>음식물 쓰레기가 아닌 것</h2>
      <p>동물 사료로 쓰기 어렵거나 딱딱한 것은 음식물이 아니라 <strong>일반쓰레기(종량제 봉투)</strong>예요. 대부분 지역에서 아래 품목을 일반쓰레기로 안내해요.</p>
      <ul>
        <li>닭뼈·돼지뼈 같은 동물 뼈</li>
        <li>조개·굴·게·가재 껍데기, 달걀·메추리알 껍데기</li>
        <li>복숭아·살구 같은 과일의 단단한 씨</li>
        <li>양파·마늘·옥수수 껍질, 티백, 한약재 찌꺼기</li>
      </ul>
      <p>음식물 쓰레기는 물기를 최대한 빼서 버려야 무게도 냄새도 줄어요. 지역마다 기준이 조금씩 다르니 애매하면 구청 안내를 따르세요.</p>

      <h2>헷갈리는 재활용, 이렇게 버려요</h2>
      <table>
        <thead><tr><th>품목</th><th>방법</th></tr></thead>
        <tbody>
          <tr><td>투명 페트병</td><td>내용물을 비우고 헹군 뒤 라벨을 떼고 납작하게 눌러 뚜껑을 닫아 투명 페트병 칸에</td></tr>
          <tr><td>비닐</td><td>내용물을 털고 헹궈 비닐류로. 음식물이 묻어 안 지워지면 일반쓰레기</td></tr>
          <tr><td>아이스팩</td><td>젤 타입은 통째로 일반쓰레기. 물 타입은 물을 버리고 비닐류로</td></tr>
          <tr><td>영수증·택배 송장</td><td>감열지라 종이 재활용이 안 돼요. 일반쓰레기</td></tr>
          <tr><td>컵라면·배달 용기</td><td>깨끗이 헹궈 재질별로. 기름이 배어 안 지워지면 일반쓰레기</td></tr>
          <tr><td>종이팩(우유팩)</td><td>헹궈 말린 뒤 종이팩 전용 수거함. 일반 종이와 섞지 않기</td></tr>
        </tbody>
      </table>

      <h2>쓰레기 버리는 날, 청소도 함께</h2>
      <p>배출일은 집 안 냄새를 잡기 좋은 날이기도 해요. 쓰레기를 내놓는 김에 <a href={path(lang, 'guides/sink-drain')}>싱크대 배수구 거름망</a>을 비우고, 음식물 통은 베이킹소다 물로 한 번 헹궈 두세요. 냄새가 오래 배어 있다면 <a href={path(lang, 'guides/shoe-cabinet')}>신발장 냄새 잡기</a>처럼 베이킹소다를 통 바닥에 조금 뿌려 두는 것도 좋아요.</p>

      <h2>자주 묻는 질문</h2>
      <p><strong>요일이 바뀌면 어떻게 하나요?</strong><br>캘린더에서 예전 "말끔" 일정을 지운 뒤, 이 페이지에서 새 요일을 골라 다시 추가하세요.</p>
      <p><strong>알림이 안 울려요.</strong><br>휴대폰 캘린더 앱의 알림이 꺼져 있지 않은지 확인하세요. 구글 캘린더로 추가했다면 알림 시간은 구글 캘린더의 기본 알림 설정을 따라요.</p>
      <p><strong>내 정보가 저장되나요?</strong><br>고른 요일은 이 기기의 브라우저에만 저장되고, 말끔 서버에는 남지 않아요.</p>
    </div>
  </article>
</Base>

<style>
  .td-head {
    margin: 28px 0 40px;
  }
  .td-sum {
    margin-top: 16px;
    font-size: clamp(17px, 1.6vw, 20px);
    max-width: 34em;
  }
  .td {
    display: grid;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: clamp(18px, 3vw, 28px);
  }
  .td-row {
    border: 0;
    border-bottom: 1px solid var(--line);
    margin: 0;
    padding: 0 0 18px;
    display: grid;
    gap: 12px;
  }
  .td-name {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .td-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    align-self: center;
  }
  .td-sub {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  .td-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
    max-width: 440px;
  }
  .td-day {
    height: 42px;
    border: 1px solid var(--line);
    background: var(--bg);
    font-size: 15px;
    font-weight: 600;
    transition: background 0.15s, color 0.15s;
  }
  .td-day[aria-pressed='true'] {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .td-time {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
  }
  .td-time input,
  .td-time select {
    font: inherit;
    font-size: 15px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 8px 10px;
  }
  .td-opts {
    display: grid;
    gap: 10px;
  }
  .td-summary {
    font-size: 15px;
    font-weight: 500;
  }
  .td-actions {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .td-google {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 14px;
  }
  .td-google a {
    border-bottom: 1px solid currentColor;
  }
  .td-note {
    font-size: 13px;
    color: var(--muted);
  }
</style>

<script>
  const DAY_KO: Record<string, string> = { MO: '월', TU: '화', WE: '수', TH: '목', FR: '금', SA: '토', SU: '일' };
  const NAMES: Record<string, string> = { g: '일반쓰레기', f: '음식물 쓰레기', r: '재활용' };
  const ALARM: Record<string, string> = { '0': '그 시각에', '30': '30분 전', '60': '1시간 전', '1440': '하루 전' };
  const ORDER = ['MO', 'TU', 'WE', 'TH', 'FR', 'SA', 'SU'];
  const STORE = 'malkkeum-trash-day';

  const form = document.getElementById('trash-form') as HTMLFormElement;
  const rows = [...form.querySelectorAll<HTMLElement>('.td-row')];
  const alarmEl = document.getElementById('alarm') as HTMLSelectElement;
  const summary = document.getElementById('summary')!;
  const actions = document.getElementById('actions')!;
  const icsLink = document.getElementById('ics-link') as HTMLAnchorElement;
  const google = document.getElementById('google-links')!;


  function read() {
    const st: Record<string, { days: string[]; time: string }> = {};
    for (const row of rows) {
      const key = row.dataset.key!;
      const days = [...row.querySelectorAll<HTMLButtonElement>('.td-day[aria-pressed="true"]')].map((b) => b.dataset.day!);
      const time = (row.querySelector('input') as HTMLInputElement).value || '20:00';
      st[key] = { days, time };
    }
    return st;
  }

  // 구글 캘린더 링크용: 오늘부터 가장 가까운 배출일
  function nextDate(days: string[]) {
    const now = new Date();
    for (let i = 0; i < 7; i++) {
      const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);
      const code = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'][d.getDay()];
      if (days.includes(code)) return d;
    }
    return now;
  }
  const pad = (n: number) => String(n).padStart(2, '0');
  const fmtTime = (hhmm: string) => {
    const [h, m] = hhmm.split(':').map(Number);
    const ap = h < 12 ? '오전' : '오후';
    const hh = h % 12 === 0 ? 12 : h % 12;
    return `${ap} ${hh}시${m ? ` ${m}분` : ''}`;
  };

  function render() {
    const st = read();
    const alarm = alarmEl.value;
    const chosen = Object.entries(st).filter(([, v]) => v.days.length);
    try {
      localStorage.setItem(STORE, JSON.stringify({ st, alarm }));
    } catch {}

    if (!chosen.length) {
      summary.textContent = '버리는 요일을 하나 이상 골라 주세요.';
      actions.hidden = true;
      return;
    }
    summary.textContent = chosen
      .map(([k, v]) => `${NAMES[k]} 매주 ${ORDER.filter((d) => v.days.includes(d)).map((d) => DAY_KO[d]).join('·')} ${fmtTime(v.time)}`)
      .join(' / ') + ` · ${ALARM[alarm]} 알림`;

    const q = new URLSearchParams();
    for (const [k, v] of chosen) {
      q.set(k, ORDER.filter((d) => v.days.includes(d)).join('.'));
      q.set(k + 't', v.time.replace(':', ''));
    }
    q.set('a', alarm);
    icsLink.href = `/api/trash-calendar.ics?${q}`;

    google.replaceChildren(
      ...chosen.map(([k, v]) => {
        const d = nextDate(v.days);
        const [h, m] = v.time.split(':').map(Number);
        const start = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}T${pad(h)}${pad(m)}00`;
        const endMin = h * 60 + m + 30;
        const end = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}T${pad(Math.floor(endMin / 60) % 24)}${pad(endMin % 60)}00`;
        const p = new URLSearchParams({
          action: 'TEMPLATE',
          text: `${NAMES[k]} 배출일`,
          dates: `${start}/${end}`,
          ctz: 'Asia/Seoul',
          recur: `RRULE:FREQ=WEEKLY;BYDAY=${ORDER.filter((x) => v.days.includes(x)).join(',')}`,
          details: '말끔 쓰레기 배출일 알림 · https://malkkeumi.com/ko/tools/trash-day/',
        });
        const a = document.createElement('a');
        a.href = `https://calendar.google.com/calendar/render?${p}`;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = `구글 캘린더에 ${NAMES[k]} 추가 ↗`;
        return a;
      }),
    );
    actions.hidden = false;
  }

  // 저장된 선택 불러오기
  try {
    const saved = JSON.parse(localStorage.getItem(STORE) || 'null');
    if (saved?.st) {
      for (const row of rows) {
        const v = saved.st[row.dataset.key!];
        if (!v) continue;
        row.querySelectorAll<HTMLButtonElement>('.td-day').forEach((b) => b.setAttribute('aria-pressed', String(v.days.includes(b.dataset.day!))));
        if (v.time) (row.querySelector('input') as HTMLInputElement).value = v.time;
      }
      if (saved.alarm) alarmEl.value = saved.alarm;
    }
  } catch {}

  form.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.td-day');
    if (!btn) return;
    btn.setAttribute('aria-pressed', String(btn.getAttribute('aria-pressed') !== 'true'));
    render();
  });
  form.addEventListener('input', render);
  form.addEventListener('submit', (e) => e.preventDefault());
  render();
</script>
