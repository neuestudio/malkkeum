---
// 루트(/)는 Worker가 기본 언어로 301 보낸다. 아래는 Worker 없이 열었을 때를 위한 대비.
import site from '../../site.config.mjs';
import { DEFAULT_LANG, path } from '../lib/i18n';
const to = path(DEFAULT_LANG);
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site).toString()} />
    <meta name="robots" content="noindex" />
    {site.GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={site.GOOGLE_SITE_VERIFICATION} />}
    {site.NAVER_SITE_VERIFICATION && <meta name="naver-site-verification" content={site.NAVER_SITE_VERIFICATION} />}
    <title>말끔</title>
  </head>
  <body><a href={to}>말끔</a></body>
</html>
