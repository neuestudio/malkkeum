---
// 청소법 준비물 섹션의 "핵심 준비물" 블록 (쿠팡 파트너스 링크)
import Media from './Media.astro';
import { t, type Lang } from '../lib/i18n';
import type { Img } from '../lib/images';

export interface KitItem {
  id: string;
  name: string;
  short: string;
  url?: string;
  img: Img;
  use?: string;
  role?: string;
}
interface Props {
  lang: Lang;
  intro: string;
  items: KitItem[];
}
const { lang, intro, items } = Astro.props;
const s = t(lang).kit;
---

<div class="kit">
  <p class="kit__h">{s.core}</p>
  <p class="kit__intro">{intro}</p>
  <ul class="kit__list">
    {
      items.map((it) => (
        <li class="kit__item">
          <div class="kit__img">
            <Media {...it.img} sizes="96px" alt={it.name} label="" tone="stone" width={400} height={400} />
          </div>
          <div class="kit__body">
            <p class="kit__name">{it.name}</p>
            <p class="kit__use">{it.use}</p>
            {it.url && (
              <a class="kit__btn" href={it.url} target="_blank" rel="sponsored nofollow noopener" aria-label={`${it.name} – ${s.go}`}>
                {s.go} ↗
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .kit {
    margin-top: 32px;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .kit__h {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .kit__intro {
    font-size: 14px;
    color: var(--muted);
    margin-top: 2px;
  }
  .kit__list {
    margin-top: 14px;
  }
  .kit__item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  @media (min-width: 640px) {
    .kit__item {
      grid-template-columns: 88px 1fr;
    }
  }
  .kit__img {
    aspect-ratio: 1;
    overflow: hidden;
  }
  .kit__img :global(.media) {
    width: 100%;
    height: 100%;
  }
  .kit__name {
    font-size: 16px;
    font-weight: 600;
  }
  .kit__use {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    margin-top: 2px;
  }
  .kit__btn {
    display: inline-flex;
    margin-top: 10px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    background: var(--text);
    color: var(--bg);
    border-radius: var(--radius);
  }
  .kit__btn:hover {
    opacity: 0.85;
  }
</style>
