---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import { slugOf } from '../lib/content';
import { path, t, type Lang } from '../lib/i18n';
import { toneOf } from '../lib/tone';
import { imageOf } from '../lib/images';

interface Props {
  entry: CollectionEntry<'guides'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const d = entry.data;
const s = t(lang);
---

<a
  class="card"
  href={path(lang, `guides/${slugOf(entry.id)}`)}
  data-space={d.space}
  data-target={d.target}
  data-difficulty={d.difficulty}
>
  <div class="card__img">
    <Media {...imageOf('guides', slugOf(entry.id), d.heroImage)} alt={d.heroAlt ?? d.title} label={s.target[d.target]} tone={toneOf(d.space)} />
  </div>
  <p class="card__cap">{s.space[d.space]}</p>
  <h3 class="card__title">{d.title}</h3>
  <p class="card__meta">
    <span class={`diff diff--${d.difficulty}`}>{s.difficulty[d.difficulty]}</span> · {s.minutes(d.duration)} · {d.frequency}
  </p>
</a>
