---
import { PUBLIC_LANGS, path, t, ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  overlay?: boolean; // 메인 대배너 위에 얹는 투명 헤더
  alternates: Partial<Record<Lang, string>>;
}
const { lang, overlay = false, alternates } = Astro.props;
const s = t(lang);
const current = Astro.url.pathname;
const navItems = [
  { key: 'guides', href: path(lang, 'guides') },
  { key: 'magazine', href: path(lang, 'magazine') },
  { key: 'picks', href: path(lang, 'picks') },
  { key: 'store', href: path(lang, 'store') },
] as const;
const otherLangs = PUBLIC_LANGS.filter((l) => l !== lang);
---

<header class:list={['hd', { 'hd--overlay': overlay }]}>
  <div class="wrap hd__in">
    <a class="logo" href={path(lang)} aria-label={s.siteName}>
      <span class="logo__en serif">Malkkeum</span>
    </a>
    <nav aria-label="main">
        <ul class="nav">
          {
            navItems.map((n) => (
              <li>
                <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>
                  {s.nav[n.key]}
                </a>
              </li>
            ))
          }
        </ul>
    </nav>
    <div class="tools">
        <a href={path(lang, 'search')} aria-label={s.nav.search} class="icon-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
            ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
          >
        </a>
        {
          otherLangs.map((l) => (
            <a class="lang" href={alternates[l] ?? path(l)} hreflang={l} lang={l}>
              {l.toUpperCase()}
              <span class="sr-only">{ui[l].langName}</span>
            </a>
          ))
        }
    </div>
  </div>
</header>

<style>
  .hd {
    position: relative;
    z-index: 20;
    height: var(--header-h);
    color: var(--text);
  }
  .hd--overlay {
    position: absolute;
    inset: 0 0 auto 0;
    color: #fffdf7;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.18);
  }
  .hd__in {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  /* 데스크톱: 로고 | 메뉴(가운데) | 도구 */
  @media (min-width: 900px) {
    .hd__in {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 32px;
    }
    .tools {
      justify-self: end;
    }
  }
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }
  .logo__en {
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  @media (max-width: 899px) {
    .logo__en {
      font-size: 24px;
    }
    .nav {
      margin-left: auto;
    }
  }
  /* 좁은 화면: 1줄 로고·도구, 2줄 메뉴 (영어 메뉴와 언어 버튼이 한 줄에 안 들어감) */
  @media (max-width: 560px) {
    .hd {
      height: auto;
    }
    .hd__in {
      flex-wrap: wrap;
      row-gap: 2px;
      padding-top: 12px;
      padding-bottom: 8px;
    }
    .tools {
      margin-left: auto;
    }
    nav {
      order: 3;
      flex: 1 0 100%;
    }
    .nav {
      margin-left: 0;
      gap: 18px;
    }
  }
  .nav {
    display: flex;
    gap: clamp(14px, 2.4vw, 32px);
    font-size: 15px;
    font-weight: 500;
  }
  .nav a {
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: currentColor;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 13px;
    font-weight: 600;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
  }
</style>
